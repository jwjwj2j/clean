{
  id: -2,
  name: 'CLEAN 补充规则',
  version: 5,
  author: 'CLEAN',
  globalGroups: [
    {
      key: 100,
      name: '开屏广告（CLEAN 兜底）',
      order: 100,
      actionMaximum: 1,
      matchTime: 8000,
      resetMatch: 'app',
      // 关键：只在下面显式列出的应用上生效。
      // 上游把这 107 个应用的通用开屏兜底显式关闭了（apps:[{id,enable:false}]），
      // 而 CLEAN 补充规则的本意就是补这个缺口。若不限定（matchAnyApp 默认 true），
      // 它会与上游规则在同一按钮上叠加，导致连点两次 —— 实测已造成
      // 「中国移动」关怀模式被误关。
      matchAnyApp: false,
      rules: [
        {
          key: 0,
          quickFind: true,
          matches: '[text*="跳过"][text.length<8][visibleToUser=true][clickable=true]',
        },
        {
          key: 1,
          matches: '[childCount=0][visibleToUser=true][clickable=true][(text.length<8&&(text*="跳过"||text*="跳過"||text*="skip"||text*="Skip"))]',
        },
        {
          key: 2,
          quickFind: true,
          matches: '[desc*="跳过"][desc.length<8][visibleToUser=true][clickable=true]',
        },
        {
          key: 3,
          matches: '[childCount=0][visibleToUser=true][clickable=true][(desc.length<8&&(desc*="跳过"||desc*="跳過"||desc*="skip"||desc*="Skip"))]',
        },
        {
          key: 4,
          quickFind: true,
          matches: '[id$="tt_splash_skip_btn"][visibleToUser=true][clickable=true]',
        },
        {
          key: 5,
          matches: '[(vid*="skip"||vid*="Skip")][visibleToUser=true][clickable=true]',
        },
        {
          key: 6,
          matches: '[vid*="count"][vid*="down"][vid!*="download"][visibleToUser=true][clickable=true]',
        },
        {
          key: 7,
          quickFind: true,
          matches: '[text*="关闭广告"][text.length<8][visibleToUser=true][clickable=true]',
        },
      ],
